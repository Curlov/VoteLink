PORT=3000
HOST=127.0.0.1
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USER=votelink
DB_PASSWORD=change-me
DB_NAME=votelink

FREE_POLL_RETENTION_DAYS=14
PUBLIC_APP_URL=http://localhost:5173
# In NODE_ENV=production ist CORS_ORIGIN Pflicht und darf nicht * sein.
# Mehrere Origins kommagetrennt eintragen.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Token fuer /operator-admin und die Betreiber-Admin-API.
OPERATOR_ADMIN_TOKEN=change-me-long-random-token
# Hinter Reverse Proxy auf 1 setzen, damit Ersteller-/Melde-IPs korrekt gelesen werden.
TRUST_PROXY=0
RATE_LIMIT_POLLS_PER_IP_HOUR=5
RATE_LIMIT_VOTES_PER_IP_MINUTE=30
RATE_LIMIT_EMAILS_PER_ADDRESS_HOUR=3

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=change-me
MAIL_FROM=VoteLink <no-reply@example.com>
